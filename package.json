{
  "name": "open-sky-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node tests/smoke.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:emulators": "npx --yes firebase-tools@15.37.0 emulators:exec --config firebase.emulators.json --project demo-opensky --only auth,firestore \"npm run test:integration\"",
    "security:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "firebase-admin": "14.5.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.1.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
